# ==============================================================================
# OpenStack Rally Monitor - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your OpenStack credentials
# cp env.sample .env

# --- OpenStack Authentication ---
OS_AUTH_URL=https://your-openstack-api:5000/v3
OS_USERNAME=rally_monitor
OS_PASSWORD=changeme
OS_PROJECT_NAME=rally_testing
OS_USER_DOMAIN_NAME=Default
OS_PROJECT_DOMAIN_NAME=Default
OS_IDENTITY_API_VERSION=3
OS_REGION_NAME=RegionOne

# --- Rally Configuration ---
# Comma-separated set of OpenStack services to monitor
# (default: keystone,nova,neutron,glance,cinder,swift). Trim this to match your
# cloud -- e.g. drop "swift" on a deployment without object storage so it stops
# showing a permanently failing column. Parsed defensively: whitespace trimmed,
# lowercased, empty segments dropped, duplicates removed, operator order kept.
# Each name needs a matching rally/scenarios/<name>.yaml to be smoke-tested and a
# registered checker (keystone,nova,neutron,glance,cinder,swift) to be
# health-checked; unknown names are skipped (smoke logs a SKIP; the health check
# logs a warning and omits them). keystone is always health-checked regardless
# (the API session authenticates against it). The seed dashboard cards are
# generated from this list on first boot.
# RALLY_SERVICES=keystone,nova,neutron,glance,cinder,swift

# Interval between full Rally test runs in minutes (default: 240 = 4 hours)
RALLY_SCHEDULE_INTERVAL=240

# Interval between lightweight API health checks in minutes (default: 15)
HEALTH_CHECK_INTERVAL=15

# Latency threshold in milliseconds above which a reachable service is reported
# "degraded" by the health check (default: 5000). Degraded counts as up for
# uptime and rally_api_up; slowness shows in rally_api_latency_milliseconds.
# HEALTH_LATENCY_WARN_MS=5000

# Results retention in days (default: 7)
RALLY_RESULTS_RETENTION_DAYS=7

# RGW provenance ledger retention in days (default: 90). Deliberately decoupled
# from RALLY_RESULTS_RETENTION_DAYS: rally_project_ids.log is the sole
# authorization basis for auto-purging rally-owned RGW orphans, so pruning it on
# the short run-retention window would degrade older orphans to "unknown owner"
# (which are never purged), making RallyRgwOrphanedUsers fire forever.
# PROVENANCE_RETENTION_DAYS=90

# Window in days for the dashboard uptime percentages (default: 30).
# Sizes the rolling smoke-test ledger and the health-check history cap.
UPTIME_WINDOW_DAYS=30

# --- Exporter Configuration ---
EXPORTER_PORT=9101

# --- Dashboard Configuration ---
DASHBOARD_PORT=8080

# --- Nova Scenario Settings ---
RALLY_NOVA_FLAVOR=m1.tiny
RALLY_NOVA_IMAGE=cirros-0.6.2-x86_64-disk

# --- Neutron Scenario Settings ---
RALLY_NEUTRON_NETWORK_CIDR=10.99.0.0/24

# --- Optional RadosGW Admin API Settings ---
# Leave unset to disable RGW orphan detection and purge.
# The credentials must belong to an RGW admin user with buckets=*;users=* caps.
RGW_ADMIN_URL=https://your-radosgw.example.com/admin
RGW_ACCESS_KEY=
RGW_SECRET_KEY=
# Optional: set if your RGW deployment requires an explicit SigV4 region.
RGW_REGION=

# --- Optional Webhook Notifications ---
# Fire a webhook on every smoke-test status TRANSITION (passed->failed or
# failed->passed). Transition-only semantics prevent per-run spam. Leave unset
# to disable (the default; no outbound HTTP from the test runner).
# NOTE: NOTIFY_WEBHOOK_URL may embed a token and, like OS_PASSWORD, lands in
# /rally/rally_env (mode 0640) so cron jobs can read it. Treat it as a secret.
# NOTIFY_WEBHOOK_URL=https://hooks.example.com/services/XXXX
# Payload format: generic (raw JSON), slack ({"text": ...}), discord ({"content": ...}).
# NOTIFY_FORMAT=generic
# Optional dashboard URL embedded in the payload / chat message.
# NOTIFY_DASHBOARD_URL=https://rally.example.com
